#!/usr/bin/env python3
"""Neo4j backup runner for TAS Scheduler.

Usage:
    python backup.py

Environment variables (or VCAP_SERVICES credentials):
    NEO4J_URI, NEO4J_USERNAME, NEO4J_PASSWORD, NEO4J_DATABASE
    S3_ENDPOINT, S3_BUCKET, S3_REGION, S3_PREFIX
    AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
    BACKUP_RETENTION_DAYS
"""

import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Dict, Optional

import boto3
from botocore.config import Config as BotoConfig
from botocore.exceptions import ClientError


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------
def _get_vcap_service(name: str) -> Optional[Dict[str, Any]]:
    vcap = os.environ.get("VCAP_SERVICES")
    if not vcap:
        return None
    try:
        services = json.loads(vcap)
        for service_type, instances in services.items():
            for instance in instances:
                if instance.get("name") == name:
                    return instance.get("credentials", {})
    except json.JSONDecodeError:
        pass
    return None


def _get_credential(
    name: str, env_var: str, default: Optional[str] = None
) -> Optional[str]:
    creds = _get_vcap_service(name)
    if creds:
        for key in creds:
            if key.lower() == env_var.lower():
                return str(creds[key])
    return os.environ.get(env_var, default)


class Config:
    NEO4J_URI: str = os.environ.get("NEO4J_URI", "bolt://localhost:7687")
    NEO4J_USERNAME: str = os.environ.get("NEO4J_USERNAME", "neo4j")
    NEO4J_PASSWORD: str = _get_credential(
        "neo4j-backup-creds", "NEO4J_PASSWORD"
    ) or os.environ.get("NEO4J_PASSWORD", "")
    NEO4J_DATABASE: str = os.environ.get("NEO4J_DATABASE", "neo4j")
    NEO4J_VERSION: str = os.environ.get("NEO4J_VERSION", "5.x")
    NEO4J_ADMIN_PATH: str = os.environ.get("NEO4J_ADMIN_PATH", "neo4j-admin")

    S3_ENDPOINT: str = os.environ.get("S3_ENDPOINT", "")
    S3_BUCKET: str = os.environ.get("S3_BUCKET", "")
    S3_REGION: str = os.environ.get("S3_REGION", "us-east-1")
    S3_PREFIX: str = os.environ.get("S3_PREFIX", "neo4j-backups")
    AWS_ACCESS_KEY_ID: str = _get_credential(
        "ecs-s3-creds", "AWS_ACCESS_KEY_ID"
    ) or os.environ.get("AWS_ACCESS_KEY_ID", "")
    AWS_SECRET_ACCESS_KEY: str = _get_credential(
        "ecs-s3-creds", "AWS_SECRET_ACCESS_KEY"
    ) or os.environ.get("AWS_SECRET_ACCESS_KEY", "")

    BACKUP_RETENTION_DAYS: int = int(os.environ.get("BACKUP_RETENTION_DAYS", "30"))
    BACKUP_DIR: str = os.environ.get("BACKUP_DIR", "/tmp/neo4j-backup")


# ---------------------------------------------------------------------------
# Neo4j Backup
# ---------------------------------------------------------------------------
def _ensure_backup_dir() -> Path:
    backup_dir = Path(Config.BACKUP_DIR)
    backup_dir.mkdir(parents=True, exist_ok=True)
    return backup_dir


def _run_neo4j_backup() -> Path:
    backup_dir = _ensure_backup_dir()
    timestamp = datetime.utcnow().strftime("%Y%m%d_%H%M%S")
    dump_name = f"{Config.NEO4J_DATABASE}_{timestamp}"
    dump_path = backup_dir / f"{dump_name}.dump"

    if Config.NEO4J_VERSION.startswith("5"):
        cmd = [
            Config.NEO4J_ADMIN_PATH,
            "database",
            "dump",
            Config.NEO4J_DATABASE,
            f"--to-path={backup_dir}",
        ]
    else:
        cmd = [
            Config.NEO4J_ADMIN_PATH,
            "dump",
            f"--database={Config.NEO4J_DATABASE}",
            f"--to={dump_path}",
        ]

    print(f"[BACKUP] Running: {' '.join(cmd)}")
    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode != 0:
        print(f"[ERROR] neo4j-admin failed:\n{result.stderr}")
        sys.exit(1)

    print(f"[BACKUP] neo4j-admin output:\n{result.stdout}")

    if Config.NEO4J_VERSION.startswith("5"):
        expected_file = backup_dir / f"{Config.NEO4J_DATABASE}.dump"
        if expected_file.exists():
            final_path = backup_dir / f"{dump_name}.dump"
            expected_file.rename(final_path)
            return final_path
        else:
            print(f"[ERROR] Expected dump file not found: {expected_file}")
            sys.exit(1)

    return dump_path


def _cleanup_local_backups():
    backup_dir = Path(Config.BACKUP_DIR)
    if backup_dir.exists():
        shutil.rmtree(backup_dir)
        print(f"[CLEANUP] Removed local backup dir: {backup_dir}")


# ---------------------------------------------------------------------------
# ECS / S3 Upload
# ---------------------------------------------------------------------------
def _get_s3_client():
    if not Config.S3_ENDPOINT:
        print("[ERROR] S3_ENDPOINT is not set.")
        sys.exit(1)
    if not Config.AWS_ACCESS_KEY_ID or not Config.AWS_SECRET_ACCESS_KEY:
        print("[ERROR] AWS credentials are not set.")
        sys.exit(1)

    session = boto3.session.Session()
    return session.client(
        "s3",
        region_name=Config.S3_REGION,
        endpoint_url=Config.S3_ENDPOINT,
        aws_access_key_id=Config.AWS_ACCESS_KEY_ID,
        aws_secret_access_key=Config.AWS_SECRET_ACCESS_KEY,
        config=BotoConfig(
            signature_version="s3v4",
            retries={"max_attempts": 3, "mode": "standard"},
        ),
    )


def _upload_file(file_path: Path) -> str:
    s3 = _get_s3_client()
    bucket = Config.S3_BUCKET
    key = f"{Config.S3_PREFIX}/{file_path.name}"

    print(f"[UPLOAD] Uploading {file_path} to s3://{bucket}/{key}")
    try:
        s3.upload_file(
            str(file_path),
            bucket,
            key,
            ExtraArgs={"ServerSideEncryption": "AES256"},
        )
        print(f"[UPLOAD] Successfully uploaded to s3://{bucket}/{key}")
    except ClientError as e:
        print(f"[ERROR] S3 upload failed: {e}")
        sys.exit(1)
    return key


def _cleanup_old_backups():
    s3 = _get_s3_client()
    bucket = Config.S3_BUCKET
    prefix = f"{Config.S3_PREFIX}/"
    retention = Config.BACKUP_RETENTION_DAYS

    if retention <= 0:
        return

    cutoff = datetime.now(timezone.utc) - timedelta(days=retention)
    print(f"[RETENTION] Removing objects older than {cutoff.isoformat()}")

    try:
        paginator = s3.get_paginator("list_objects_v2")
        deleted = 0
        for page in paginator.paginate(Bucket=bucket, Prefix=prefix):
            for obj in page.get("Contents", []):
                if obj["LastModified"] < cutoff:
                    s3.delete_object(Bucket=bucket, Key=obj["Key"])
                    print(f"[RETENTION] Deleted {obj['Key']}")
                    deleted += 1
        print(f"[RETENTION] Total deleted: {deleted}")
    except ClientError as e:
        print(f"[WARN] Failed to cleanup old backups: {e}")


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
def main():
    print("[START] Neo4j backup job started")

    backup_file = _run_neo4j_backup()
    _upload_file(backup_file)
    _cleanup_old_backups()
    _cleanup_local_backups()

    print("[DONE] Neo4j backup job completed successfully")
    return 0


if __name__ == "__main__":
    sys.exit(main())



applications:
  - name: neo4j-backup-runner
    memory: 2G
    disk_quota: 4G
    instances: 0
    buildpacks:
      - https://github.com/cloudfoundry/apt-buildpack.git
      - python_buildpack
    command: echo "Task runner ready"
    health-check-type: process
    no-route: true
    env:
      NEO4J_VERSION: "5.x"
      NEO4J_DATABASE: "neo4j"
      NEO4J_URI: "bolt://neo4j.example.com:7687"
      NEO4J_USERNAME: "neo4j"
      # NEO4J_PASSWORD: set via service binding or env
      # AWS_ACCESS_KEY_ID: set via service binding or env
      # AWS_SECRET_ACCESS_KEY: set via service binding or env
      S3_ENDPOINT: "https://ecs.example.com:9021"
      S3_BUCKET: "neo4j-backups"
      S3_REGION: "us-east-1"
      BACKUP_RETENTION_DAYS: "30"
    services:
      - neo4j-backup-scheduler


