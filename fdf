#!/bin/bash
set -euo pipefail

echo "[INFO] Starting backup runner..."

# Ensure neo4j-admin is available if installed via apt-buildpack
export PATH="/usr/bin:/usr/local/bin:$HOME/neo4j/bin:$PATH"

# If neo4j-admin not found, try to locate it
if ! command -v neo4j-admin &> /dev/null; then
    echo "[WARN] neo4j-admin not in PATH. Checking common locations..."
    for p in /usr/share/neo4j/bin/neo4j-admin /var/vcap/packages/neo4j/bin/neo4j-admin; do
        if [ -x "$p" ]; then
            export NEO4J_ADMIN_PATH="$p"
            echo "[INFO] Found neo4j-admin at $p"
            break
        fi
    done
fi

python3 backup.py
