NEO4J_USER = "nailproduser"
NEO4J_PASSWORD = "nAll-PU-45678utggtrelkiop90sd^ewqrt4fdgvc!"
NEO4J_DATABASE = "neo4j"
NEO4J_ENCRYPTED = False
NEO4J_TRUST = "TRUST_ALL_CERTIFICATES"

S3_ENDPOINT = "https://object1.cs.boeing.com:9021"
S3_BUCKET = "pcf-4d0a80d4-d7f0-4578-b02e-eb2780c564cf"
S3_PREFIX = "neo4j-backups"
S3_PATH_STYLE_ACCESS = True
AWS_ACCESS_KEY_ID = "pcf-40b0ed8b-f630-4014-9536-1ce4bb37d203"
AWS_SECRET_ACCESS_KEY = "Gch5+QyHt194m21UP1co3oQxw/CiTy8g2Qg9FG7q"

BACKUP_DIR = "backups"
BACKUP_RETENTION_DAYS = 30
SCHEDULE_TIME = "02:00"


# ---------------------------------------------------------------------------
# S3 Helpers
# ---------------------------------------------------------------------------
def _get_s3_client():
    boto_conf = BotoConfig(
        signature_version="s3v4",
        retries={"max_attempts": 3, "mode": "standard"},
    )
    if S3_PATH_STYLE_ACCESS:
        boto_conf = BotoConfig(
            signature_version="s3v4",
            retries={"max_attempts": 3, "mode": "standard"},
            s3={"addressing_style": "path"},
        )

    session = boto3.session.Session()
    return session.client(
        "s3",
        region_name="us-east-1",  # default; set AWS_REGION env var to override
        endpoint_url=S3_ENDPOINT,
        aws_access_key_id=AWS_ACCESS_KEY_ID,
        aws_secret_access_key=AWS_SECRET_ACCESS_KEY,
        config=boto_conf,
    )


def _upload_to_s3(file_path: Path) -> bool:
    try:
        s3 = _get_s3_client()
        key = f"{S3_PREFIX}/{file_path.name}"

        print(f"[UPLOAD] Uploading {file_path} to s3://{S3_BUCKET}/{key}")
        s3.upload_file(
            str(file_path),
            S3_BUCKET,
            key,
            ExtraArgs={"ServerSideEncryption": "AES256"},
        )
        print(f"[UPLOAD] Success: s3://{S3_BUCKET}/{key}")
        return True
    except Exception as e:
        print(f"[WARN] S3 upload failed: {e}")
        return False


def _cleanup_old_s3_backups():
    try:
        s3 = _get_s3_client()
        prefix = f"{S3_PREFIX}/"
        cutoff = datetime.now() - timedelta(days=BACKUP_RETENTION_DAYS)

        paginator = s3.get_paginator("list_objects_v2")
        for page in paginator.paginate(Bucket=S3_BUCKET, Prefix=prefix):
            for obj in page.get("Contents", []):
                if obj["LastModified"].replace(tzinfo=None) < cutoff:
                    s3.delete_object(Bucket=S3_BUCKET, Key=obj["Key"])
                    print(f"[RETENTION] Deleted from S3: {obj['Key']}")
    except Exception as e:
        print(f"[WARN] S3 cleanup failed: {e}")


# ---------------------------------------------------------------------------
# Local Helpers
# ---------------------------------------------------------------------------
def _cleanup_old_local_backups():
    backup_dir = Path(BACKUP_DIR)
    if not backup_dir.exists():
        return

    cutoff = datetime.now() - timedelta(days=BACKUP_RETENTION_DAYS)
    for item in backup_dir.iterdir():
        if item.is_dir() or item.suffix in (".tar.gz", ".dump"):
            mtime = datetime.fromtimestamp(item.stat().st_mtime)
            if mtime < cutoff:
                if item.is_dir():
                    shutil.rmtree(item)
                else:
                    item.unlink()
                print(f"[RETENTION] Deleted local: {item}")


# ---------------------------------------------------------------------------
# Backup job
# ---------------------------------------------------------------------------
def _run_backup():
    print(f"[START] Backup job started at {datetime.now().isoformat()}")

    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    archive_name = f"{NEO4J_DATABASE}_{timestamp}.tar.gz"
    archive_path = Path(BACKUP_DIR) / archive_name

    # Ensure local dir exists
    Path(BACKUP_DIR).mkdir(parents=True, exist_ok=True)

    # 1. Extract from Neo4j
    extract_dir = Path(BACKUP_DIR) / f"{NEO4J_DATABASE}_{timestamp}"
    neo4j_ok = False

    try:
        print(f"[BACKUP] Connecting to {NEO4J_URI}")
        driver = GraphDatabase.driver(
            NEO4J_URI,
            auth=(NEO4J_USER, NEO4J_PASSWORD),
            encrypted=NEO4J_ENCRYPTED,
            trust=NEO4J_TRUST,
        )

        extractor = Extractor(
            project_dir=str(extract_dir),
            driver=driver,
            database=NEO4J_DATABASE,
            input_yes=False,
            compress=True,
            indent_size=4,
            pull_uniqueness_constraints=True,
        )
        extractor.extract_data()
        driver.close()
        print(f"[BACKUP] Data extracted to {extract_dir}")
        neo4j_ok = True
    except Exception as e:
        print(f"[ERROR] Neo4j extract failed: {e}")
        return

    # 2. Package into tar.gz
    try:
        print(f"[ARCHIVE] Creating {archive_path}")
        with tarfile.open(archive_path, "w:gz") as tar:
            tar.add(extract_dir, arcname=extract_dir.name)
        print(f"[ARCHIVE] Created {archive_path} ({archive_path.stat().st_size} bytes)")
    except Exception as e:
        print(f"[ERROR] Archive failed: {e}")
        return
    finally:
        # Always remove extracted dir to save space
        if extract_dir.exists():
            shutil.rmtree(extract_dir)

    # 3. Try S3 upload
    s3_ok = _upload_to_s3(archive_path)

    if s3_ok:
        # Uploaded to S3 — remove local copy
        archive_path.unlink()
        print(f"[CLEANUP] Removed local archive after S3 upload")
        _cleanup_old_s3_backups()
    else:
        # S3 failed — keep local copy
        print(f"[FALLBACK] Keeping local backup: {archive_path}")
        _cleanup_old_local_backups()

    print(f"[DONE] Backup completed at {datetime.now().isoformat()}")


# ---------------------------------------------------------------------------
# Main loop
# ---------------------------------------------------------------------------
def main():
    print("[INIT] Neo4j cron backup service starting...")
    print(f"[CONFIG] uri={NEO4J_URI}, database={NEO4J_DATABASE}")
    print(f"[CONFIG] s3_bucket={S3_BUCKET}, s3_endpoint={S3_ENDPOINT}")
    print(f"[CONFIG] local_dir={BACKUP_DIR}, retention={BACKUP_RETENTION_DAYS}d")
    print(f"[CONFIG] schedule={SCHEDULE_TIME}")

    schedule.every().day.at(SCHEDULE_TIME).do(_run_backup)
    print(f"[SCHEDULE] Running daily at {SCHEDULE_TIME}")

    while True:
        schedule.run_pending()
        time.sleep(60)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] in ("--now", "-n", "test"):
        print("[TEST] Running single backup now...")
        sys.exit(_run_backup() or 0)
    sys.exit(main())
