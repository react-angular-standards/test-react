#!/usr/bin/env python3
"""Neo4j backup runner using neo4j_backup.Extractor.

Tries to upload to S3 (Dell ECS) first.
Falls back to local storage if Neo4j or S3 is unreachable.

Runs continuously with a daily Python cron job.
"""

import shutil
import sys
import tarfile
import time
from datetime import datetime, timedelta
from pathlib import Path

import boto3
import schedule
from botocore.config import Config as BotoConfig
from botocore.exceptions import ClientError
from neo4j import GraphDatabase
from neo4j_backup import Extractor

